<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>middleware_bridge</name>
  <version>0.1.0</version>
  <description>
    Camada de integração ROS2 do middleware IA-UAV. Contém apenas
    "plumbing" (assinar/publicar tópicos, converter tipos): toda a lógica
    de decisão vive no pacote Python puro middleware_core, instalado
    separadamente via pip.
  </description>
  <maintainer email="rafael.souza@example.com">Rafael Santos Souza</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!--
    middleware_core NÃO é um pacote ROS/ament: é uma biblioteca Python
    pura instalada via pip. Instale-a no mesmo ambiente Python usado pelo
    ROS2 ANTES de rodar `colcon build`:

        pip install -e /caminho/para/middleware_core

    Isso é documentado aqui (em vez de um <depend> inválido) para deixar
    explícito que essa dependência existe e precisa ser resolvida
    manualmente uma vez por ambiente.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
